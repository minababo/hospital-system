# Django secret key (required, no default). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

CSRF_TRUSTED_ORIGINS=

# Database connection URL. Leave unset to use local SQLite (db.sqlite3).
# Supabase (session pooler) example:
# DATABASE_URL=postgres://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Seconds to keep a database connection open between requests (0 = close after each request).
CONN_MAX_AGE=60

# HSTS max-age in seconds (only applied when DEBUG=False). Raise once HTTPS is confirmed.
SECURE_HSTS_SECONDS=3600

# Redirect HTTP to HTTPS inside Django (only when DEBUG=False). Render already does this.
SECURE_SSL_REDIRECT=False

# Root logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Email backend. Defaults to console when DEBUG=True and SMTP when DEBUG=False.
# MAILER_BACKEND=django.core.mail.backends.console.EmailBackend

# Minutes of inactivity before a user is logged out.
SESSION_IDLE_TIMEOUT_MINUTES=30
